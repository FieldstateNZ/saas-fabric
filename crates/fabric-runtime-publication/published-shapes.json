{
  "about": "The published shape of tenants.json, data-sources.json, catalog.json and the publication.json keys readers read, and the minimum reader contract it was recorded at. Written by `FABRIC_WRITE_PUBLISHED_SHAPES=1 cargo test -p fabric-runtime-publication --test published_shapes`. scripts/check_reader_floor.py fails CI when shapes change without minimumReaderContract rising.",
  "minimumReaderContract": 1,
  "shapes": {
    "catalog.json": [
      "$.*.collection: string",
      "$.*.data_source: string",
      "$.*.key_field: string",
      "$.*.operations: array",
      "$.*.operations[]: one of \"create\"",
      "$.*.operations[]: one of \"delete\"",
      "$.*.operations[]: one of \"list\"",
      "$.*.operations[]: one of \"read\"",
      "$.*.operations[]: one of \"update\"",
      "$.*.queryable_fields: array",
      "$.*.queryable_fields[]: string",
      "$.*: object",
      "$: map"
    ],
    "data-sources.json": [
      "$: array",
      "$[].capabilities.accepts_new_tenants: boolean",
      "$[].capabilities.writable: boolean",
      "$[].capabilities: object",
      "$[].connection: object tagged by kind",
      "$[].connection<kind=default>: object",
      "$[].connection<kind=named>.name: string",
      "$[].connection<kind=named>: object",
      "$[].connection<kind=secret>.reference: string",
      "$[].connection<kind=secret>: object",
      "$[].connector: string",
      "$[].id: string",
      "$[].labels.*: string",
      "$[].labels: map",
      "$[].placement: one of \"dedicated\"",
      "$[].placement: one of \"development\"",
      "$[].placement: one of \"ephemeral\"",
      "$[].placement: one of \"high_availability\"",
      "$[].placement: one of \"regulated\"",
      "$[].placement: one of \"shared\"",
      "$[].pool.acquire_timeout_seconds: integer",
      "$[].pool.idle_timeout_seconds: integer",
      "$[].pool.max_connections: integer",
      "$[].pool: object",
      "$[].residency.jurisdiction: may be absent",
      "$[].residency.jurisdiction: string",
      "$[].residency.region: string",
      "$[].residency: object",
      "$[].revision: integer",
      "$[]: object"
    ],
    "publication.json": [
      "$.documents.catalog.sha256: string",
      "$.documents.catalog: object",
      "$.documents.data-sources.sha256: string",
      "$.documents.data-sources: object",
      "$.documents.tenants.sha256: string",
      "$.documents.tenants: object",
      "$.documents: object",
      "$.generation: integer",
      "$.minimum_reader_contract: integer",
      "$: object"
    ],
    "tenants.json": [
      "$: array",
      "$[].configuration.profile: may be absent",
      "$[].configuration.profile: string",
      "$[].configuration.store: string",
      "$[].configuration: may be absent",
      "$[].configuration: object",
      "$[].data.*.data_source: string",
      "$[].data.*.isolation: object tagged by kind",
      "$[].data.*.isolation<kind=database>: object",
      "$[].data.*.isolation<kind=discriminator>.column: string",
      "$[].data.*.isolation<kind=discriminator>.value: string",
      "$[].data.*.isolation<kind=discriminator>: object",
      "$[].data.*.isolation<kind=schema>.schema: string",
      "$[].data.*.isolation<kind=schema>: object",
      "$[].data.*: object",
      "$[].data: map",
      "$[].features.*: boolean",
      "$[].features: map",
      "$[].revision: integer",
      "$[].secrets: may be absent",
      "$[].secrets: string",
      "$[].storage.*.container: string",
      "$[].storage.*.credentials: may be absent",
      "$[].storage.*.credentials: string",
      "$[].storage.*.prefix: may be absent",
      "$[].storage.*.prefix: string",
      "$[].storage.*.provider: string",
      "$[].storage.*: object",
      "$[].storage: map",
      "$[].tenant: string",
      "$[]: object"
    ]
  }
}
