#
# The shipped console image (apps/control-plane-ui/Dockerfile, target
# `console`) serves static files and deliberately does not proxy `/api`: that
# routing belongs to the operator ingress. In this disposable profile the
# console's own nginx *is* that ingress, so this file replaces
# /etc/nginx/conf.d/default.conf (read-only bind mount) and adds exactly one
# thing: `/api/` proxied to the control-plane service on the internal network.
#
# Everything else is the shipped configuration, byte for byte where it
# matters: `dogfood.py check` verifies that every `add_header` line of
# apps/control-plane-ui/nginx.conf at the pinned commit is present here, so the
# security headers cannot be weakened by editing this file.

map $sent_http_content_type $console_cache_control {
    default                 "no-store";
    ~*^(text/css|application/javascript) "public, max-age=31536000, immutable";
}

server {
    listen @@CONSOLE_PORT@@;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

@@SECURITY_HEADERS@@

    location / {
        try_files $uri $uri/ =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The one addition. Docker's embedded DNS resolves the service name; the
    # variable form makes nginx resolve at request time rather than refusing
    # to start if the control plane is not up yet.
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $control_plane @@CP_UPSTREAM@@;
        proxy_pass $control_plane;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 35s;
    }
}
