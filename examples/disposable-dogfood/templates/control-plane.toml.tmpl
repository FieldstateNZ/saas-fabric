# GENERATED by examples/disposable-dogfood/dogfood.py -- do not edit by hand.
# `dogfood.py check` re-renders this file from profile.toml and refuses to
# proceed if the bytes on disk differ, so an edit here is a refused run, not a
# quiet change of posture.
#
# Disposable internal dogfood profile for the SaaS Fabric control plane at
# source commit @@SOURCE_COMMIT@@.
#
# Every adapter below is a development adapter the control plane already
# names and warns about at startup (see crates/fabric-control-plane-api/src/
# config/*.rs). This configuration names no shared Keycloak, OpenBao or Git
# host: the only address in it is the throwaway Keycloak on this profile's
# own internal Docker network. Whether the container can REACH anything else
# is a property of the host firewall gate, not of this file.

listen = "0.0.0.0:@@CP_PORT@@"
request_timeout_seconds = 30

[control_plane.operator]
# The only posture. Interactive sign-in is real OIDC against the disposable
# realm; there is no header shortcut and the test-only AcceptingOperator is an
# `[[example]]` that no shipped image contains.
mode = "oidc"

# What a token says, and where the browser is sent: the Keycloak port
# published on the host's loopback only.
issuer = "@@ISSUER@@"

# Where the control plane itself redeems a code and reads signing keys: the
# Keycloak service on the internal network. The browser never sees this.
reachable_at = "@@REACHABLE_AT@@"

client_id = "@@CLIENT_ID@@"
required_role = "@@REQUIRED_ROLE@@"

# The console's origin root, with the trailing slash the console serves (no
# history fallback, so `/callback` would answer 404).
redirect_uri = "@@REDIRECT_URI@@"

# Startup ordering, not authentication. The control plane reads the realm's
# signing keys once at startup and again every `jwks_refresh_seconds`; the
# disposable realm is bootstrapped after the control plane starts, so with the
# production default (300) every bearer would be refused for up to five
# minutes. Keys are still read from the issuer and every token is still
# verified. The validator requires exactly this value.
jwks_refresh_seconds = @@JWKS_REFRESH_SECONDS@@

[control_plane.reconciliation]
interval_seconds = 60

# A tmpfs inside the control-plane container. Everything an operator drafts
# -- clients, the catalogue -- is lost when the container stops. Accepted.
[desired_state]
mode = "local_directory"
path = "@@CP_STATE_PATH@@"

# Converges nothing; every client reports pending. The disposable Keycloak is
# used for operator sign-in only and is never written to by reconciliation.
[identity_provider]
mode = "in_memory"

# Lost when the process stops. No OpenBao anywhere near this profile.
[secret_store]
mode = "in_memory"

# Defaults restated so the validator can check the request budget rule the
# control plane enforces at startup (10 + 8 + 10 < 30).
[registries]
http_timeout_seconds = 10
resolution_budget_seconds = 8

# Deliberately absent: [platform_management] (no platform repository, no
# deployment registry, no cluster) and [git_host] (defaults only, never used
# because no Git integration can be connected without a public base URL).
