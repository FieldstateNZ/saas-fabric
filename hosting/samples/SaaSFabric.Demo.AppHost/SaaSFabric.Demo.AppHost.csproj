<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- Keep dashboard and orchestration on the exact versions in packages.lock.json. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>saas-fabric-hosting-demo</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <ProjectReference Include="../../src/SaaSFabric.Aspire.Hosting/SaaSFabric.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
